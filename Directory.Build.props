<Project>
  <PropertyGroup>
    <!-- Base version components: update these when bumping the version -->
    <VersionMajor>1</VersionMajor>
    <VersionMinor>3</VersionMinor>
    <VersionBase>$(VersionMajor).$(VersionMinor)</VersionBase>
    <Authors>Soroush Falahati, LenovoLegionToolkit-Team</Authors>
    <Copyright>Copyright © Soroush Falahati (falahati.net)</Copyright>
    <RepositoryUrl>https://github.com/LenovoLegionToolkit-Team/WindowsDisplayAPI</RepositoryUrl>
    <PackageProjectUrl>https://github.com/LenovoLegionToolkit-Team/WindowsDisplayAPI</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <!-- Prevent SourceLink from appending a second commit SHA to InformationalVersion -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
